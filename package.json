{
  "name": "@red-cup-engineering/deterministic-intent-admission-service",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A deterministic service that admits a bounded agentic request as an exact executable intent contract.",
  "keywords": [
    "agentic-orchestration",
    "intent-admission",
    "deterministic",
    "capability-cell"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/deterministic-intent-admission-service.git"
  },
  "homepage": "https://deterministic-intent-admission.actions.561.group/",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "bin/",
    "content/",
    "src/",
    "types/"
  ],
  "bin": {
    "admit-bounded-agentic-intent": "./bin/admit-bounded-agentic-intent.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./src/admit-bounded-agentic-intent.mjs"
    }
  },
  "scripts": {
    "check": "node --check src/admit-bounded-agentic-intent.mjs && node --check src/worker.mjs && node --check bin/admit-bounded-agentic-intent.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test && npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@lenticule-science/rmn-semantic-conformance-die": "6.0.1"
  }
}
